QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Text put in front of QUERIES only (never documents, so no re-ingest; ADR-0025).
# Unset: BGE models (BAAI/bge-*) get "Represent this sentence for searching relevant
# passages: ", other models get none. Set to an empty string to switch the prefix off.
# EMBEDDING_QUERY_PREFIX=
# Cross-encoder that re-scores the top 20 hits and keeps the best 5 (Phase 10).
# Unset = this MiniLM model (ADR-0026). Empty or "none" = off: the rerank step then only
# keeps the first 5 hits. Downloads from Hugging Face on first use (91 MB; cached in
# HF_HOME; Compose: huggingface_cache volume). Loaded on the first request, no warm-up.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PAPERS_DIR=data/papers
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_THINK=false
# Context window sent to Ollama on every call, including warmup (Phase 8 full-text chunks).
OLLAMA_NUM_CTX=8192
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opt-in LangSmith tracing (ADR-0019). Off unless LANGSMITH_TRACING=true and a key is set.
# When on, prompts and outputs are sent to LangSmith: public-paper corpus only, never PHI.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medai-paperlens
# Eval sync/experiments (Phase 9): only for an EU-region LangSmith account, e.g. https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=

# scripts/benchmark_llm.py / scripts/eval_llm.py only
BENCHMARK_MODELS=ollama:qwen3.5:4b,ollama:qwen3:1.7b,gemini:gemini-2.0-flash
BENCHMARK_THINK_MODES=no_think,think
BENCHMARK_OUTPUT=benchmark_results.csv

# Docker Compose overrides (already set in docker-compose.yml environment blocks):
# QDRANT_URL=http://qdrant:6333
# OLLAMA_BASE_URL=http://ollama:11434
# API_BASE_URL=http://api:8000
